# API Key 环境变量（复制为 .env 或直接在 shell 导出，切勿提交到git）
# .env 已被 .gitignore 拦截；Windows 下权限已收紧为仅当前用户可读写
# 火山方舟（字节跳动）
VOLCENGINE_API_KEY=your-volcengine-api-key
# 阿里云百炼
DASHSCOPE_API_KEY=your-dashscope-api-key
# DeepSeek 官方（可选：提供后在 config/models.yaml 启用 judge_official 角色）
DEEPSEEK_API_KEY=your-deepseek-api-key
